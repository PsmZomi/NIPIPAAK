rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function pawlpiRole() {
      return get(/databases/$(database)/documents/pawlpi_roles/$(request.auth.uid)).data.role;
    }

    function isPawlpiEditor() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/pawlpi_roles/$(request.auth.uid))
        && pawlpiRole() == 'editor';
    }

    function isPawlpiViewerOrEditor() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/pawlpi_roles/$(request.auth.uid))
        && (pawlpiRole() == 'editor' || pawlpiRole() == 'viewer');
    }

    // Pawlpi: role on any NIPIPAAK Auth user (UID = doc id)
    match /pawlpi_roles/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /pawlpi_stores/{docId} {
      allow read: if isPawlpiViewerOrEditor();
      allow create, update, delete: if isPawlpiEditor();
    }

    // Blogs
    match /blogs/{docId} {
      allow read: if true;
      allow write: if request.auth != null;

      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.auth != null
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string;
        allow update, delete: if request.auth != null
          && resource.data.uid == request.auth.uid;
      }
    }

    // News
    match /news/{docId} {
      allow read: if true;
      allow write: if request.auth != null;

      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.auth != null
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string;
        allow update, delete: if request.auth != null
          && resource.data.uid == request.auth.uid;
      }
    }

    // Songs
    match /songs/{docId} {
      allow read: if true;
      allow write: if request.auth != null;

      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.auth != null
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string;
        allow update, delete: if request.auth != null
          && resource.data.uid == request.auth.uid;
      }
    }

    // World Cup Predictions
    match /worldcup_predictions/{docId} {
      allow read: if true;

      allow create: if
        request.resource.data.name is string &&
        request.resource.data.phone is string &&
        request.resource.data.teamA is string &&
        request.resource.data.teamB is string &&
        request.resource.data.scoreA is int &&
        request.resource.data.scoreB is int;

      allow update, delete: if false;
    }

    // Match Settings
    match /worldcup_settings/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Public gallery — anyone can view; only signed-in NIPIPAAK users can create
    // Publish these rules in Firebase Console (repo file does not auto-deploy).
    match /gallery_albums/{albumId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.keys().hasAll(['name', 'createdAt']);
      allow update, delete: if false;
    }

    match /gallery_photos/{photoId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.albumId is string
        && request.resource.data.albumName is string
        && request.resource.data.publicId is string
        && request.resource.data.url is string
        && request.resource.data.caption is string
        && request.resource.data.keys().hasAll([
          'albumId', 'albumName', 'publicId', 'url', 'caption', 'createdAt'
        ]);
      allow update, delete: if false;
    }
  }
}
